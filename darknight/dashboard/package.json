{
  "name": "darknight-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode local",
    "build": "vite build --mode prod",
    "build:local": "vite build --mode local",
    "preview": "vite preview --port 3000",
    "ts:check": "vue-tsc --noEmit",
    "lint": "npm run lint:eslint:check && npm run lint:style:check && npm run lint:format:check",
    "lint:eslint": "eslint --fix \"src/**/*.{vue,ts,tsx,js}\"",
    "lint:eslint:check": "eslint \"src/**/*.{vue,ts,tsx,js}\"",
    "lint:style": "stylelint --fix \"src/**/*.{vue,css,scss}\"",
    "lint:style:check": "stylelint \"src/**/*.{vue,css,scss}\"",
    "lint:format": "prettier --write \"src/**/*.{vue,ts,tsx,js,json,scss}\"",
    "lint:format:check": "prettier --check \"src/**/*.{vue,ts,tsx,js,json,scss}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@paypal/paypal-js": "^11.0.0",
    "@tanstack/vue-query": "^5.101.4",
    "@vueuse/core": "^12.5.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.13",
    "element-plus": "^2.9.4",
    "pinia": "^2.3.1",
    "qrcode.vue": "^3.6.0",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "sass": "^1.84.0",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-auto-import": "^19.0.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^6.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
